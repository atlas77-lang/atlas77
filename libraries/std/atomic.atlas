import "std/concepts/primitive";

private extern fun atomic_init<T: std::primitive>(obj: *__atomic T, val: T);

private extern fun atomic_store<T: std::primitive>(obj: *__atomic T, val: T);
private extern fun atomic_store_explicit<T: std::primitive>(obj: *__atomic T, val: T, order: MEMORY_ORDERING);

private extern fun atomic_load<T: std::primitive>(obj: *__atomic T) -> T;
private extern fun atomic_load_explicit<T: std::primitive>(obj: *__atomic T, order: MEMORY_ORDERING) -> T;

private extern fun atomic_exchange<T: std::primitive>(obj: *__atomic T, val: T) -> T;
private extern fun atomic_exchange_explicit<T: std::primitive>(obj: *__atomic T, val: T, order: MEMORY_ORDERING) -> T;

private extern fun atomic_compare_exchange_strong<T: std::primitive>(obj: *__atomic T, expected: *T, desired: T) -> bool;
private extern fun atomic_compare_exchange_strong_explicit<T: std::primitive>(obj: *__atomic T, expected: *T, desired: T, success_order: MEMORY_ORDERING, failure_order: MEMORY_ORDERING) -> bool;

private extern fun atomic_compare_exchange_weak<T: std::primitive>(obj: *__atomic T, expected: *T, desired: T) -> bool;
private extern fun atomic_compare_exchange_weak_explicit<T: std::primitive>(obj: *__atomic T, expected: *T, desired: T, success_order: MEMORY_ORDERING, failure_order: MEMORY_ORDERING) -> bool;

private extern fun atomic_fetch_add<T: std::primitive>(obj: *__atomic T, val: T) -> T;
private extern fun atomic_fetch_add_explicit<T: std::primitive>(obj: *__atomic T, val: T, order: MEMORY_ORDERING) -> T;

private extern fun atomic_fetch_sub<T: std::primitive>(obj: *__atomic T, val: T) -> T;
private extern fun atomic_fetch_sub_explicit<T: std::primitive>(obj: *__atomic T, val: T, order: MEMORY_ORDERING) -> T;

private extern fun atomic_fetch_or<T: std::primitive>(obj: *__atomic T, val: T) -> T;
private extern fun atomic_fetch_or_explicit<T: std::primitive>(obj: *__atomic T, val: T, order: MEMORY_ORDERING) -> T;

private extern fun atomic_fetch_xor<T: std::primitive>(obj: *__atomic T, val: T) -> T;
private extern fun atomic_fetch_xor_explicit<T: std::primitive>(obj: *__atomic T, val: T, order: MEMORY_ORDERING) -> T;

private extern fun atomic_fetch_and<T: std::primitive>(obj: *__atomic T, val: T) -> T;
private extern fun atomic_fetch_and_explicit<T: std::primitive>(obj: *__atomic T, val: T, order: MEMORY_ORDERING) -> T;

private extern fun atomic_thread_fence(order: MEMORY_ORDERING);
private extern fun atomic_signal_fence(order: MEMORY_ORDERING);

private extern fun atomic_is_lock_free<T: std::primitive>(obj: *__atomic T) -> bool;

private extern fun atomic_flag_test_and_set(obj: *atomic_flag) -> bool;
private extern fun atomic_flag_test_and_set_explicit(obj: *atomic_flag, order: MEMORY_ORDERING) -> bool;
private extern fun atomic_flag_clear(obj: *atomic_flag);
private extern fun atomic_flag_clear_explicit(obj: *atomic_flag, order: MEMORY_ORDERING);

public extern fun ATOMIC_VAR_INIT<T: std::primitive>(value: T) -> __atomic T;

private enum MEMORY_ORDERING {
    RELAXED = 0;
    CONSUME = 1;
    ACQUIRE = 2;
    RELEASE = 3;
    ACQUIRE_RELEASE = 4;
    SEQUENTIALLY_CONSISTENT = 5;
}

namespace std {
    #[std::non_copyable]
    public struct atomic<T: std::primitive> {
      private:
        value: __atomic T;
      public:
        fun new(val: T) -> std::atomic<T> {
            return std::atomic<T>{ .value = ATOMIC_VAR_INIT(val) };
        }

        fun load(*const this) -> T {
            return atomic_load(&this->value);
        }
        fun load_explicit(*const this, order: MEMORY_ORDERING) -> T {
            return atomic_load_explicit(&this->value, order);
        }
        fun store(*this, val: T) {
            atomic_store(&this->value, val);
        }
        fun store_explicit(*this, val: T, order: MEMORY_ORDERING) {
            atomic_store_explicit(&this->value, val, order);
        }
        fun exchange(*this, val: T) -> T {
            return atomic_exchange(&this->value, val);
        }
        fun exchange_explicit(*this, val: T, order: MEMORY_ORDERING) -> T {
            return atomic_exchange_explicit(&this->value, val, order);
        }
        fun is_lock_free(*const this) -> bool {
            return atomic_is_lock_free(&this->value);
        }

        fun compare_exchange_strong(*this, expected: *T, desired: T) -> bool {
            return atomic_compare_exchange_strong(&this->value, expected, desired);
        }
        fun compare_exchange_strong_explicit(*this, expected: *T, desired: T, order: MEMORY_ORDERING) -> bool {
            return atomic_compare_exchange_strong_explicit(&this->value, expected, desired, order);
        }
        fun compare_exchange_weak(*this, expected: *T, desired: T) -> bool {
            return atomic_compare_exchange_weak(&this->value, expected, desired);
        }
        fun compare_exchange_weak_explicit(
            *this, 
            expected: *T, 
            desired: T, 
            success_order: MEMORY_ORDERING, 
            failure_order: MEMORY_ORDERING) -> bool 
        {
            return atomic_compare_exchange_weak_explicit(
                &this->value, 
                expected, 
                desired, 
                success_order, 
                failure_order);
        }

        // Potentially Add `Where T: Primitive` to this section to ensure "atomic_fetch_add" is not misused
        // At least temporarily

        // Should be "where T: AddAssign" but it doesn't exist yet
        fun fetch_add(*this, val: T) -> T
            where T: operator::add 
        {
            return atomic_fetch_add(&this->value, val);
        }
        fun fetch_add_explicit(*this, val: T, order: MEMORY_ORDERING) -> T
            where T: operator::add 
        {
            return atomic_fetch_add_explicit(&this->value, val, order);
        }
        // Should be "where T: SubAssign" but it doesn't exist yet
        fun fetch_sub(*this, val: T) -> T
            where T: operator::sub 
        {
            return atomic_fetch_sub(&this->value, val);
        }
        fun fetch_sub_explicit(*this, val: T, order: MEMORY_ORDERING) -> T
            where T: operator::sub 
        {
            return atomic_fetch_sub_explicit(&this->value, val, order);
        }
        // Should be "where T: OrAssign" but it doesn't exist yet
        fun fetch_or(*this, val: T) -> T
            where T: operator::bin_or 
        {
            return atomic_fetch_or(&this->value, val);
        }
        fun fetch_or_explicit(*this, val: T, order: MEMORY_ORDERING) -> T
            where T: operator::bin_or 
        {
            return atomic_fetch_or_explicit(&this->value, val, order);
        }
        // Should be "where T: AndAssign" but it doesn't exist yet
        fun fetch_and(*this, val: T) -> T
            where T: operator::bin_and 
        {
            return atomic_fetch_and(&this->value, val);
        }
        fun fetch_and_explicit(*this, val: T, order: MEMORY_ORDERING) -> T
            where T: operator::bin_and 
        {
            return atomic_fetch_and_explicit(&this->value, val, order);
        }
        // Should be "where T: XorAssign" but it doesn't exist yet
        fun fetch_xor(*this, val: T) -> T
            where T: operator::bin_xor 
        {
            return atomic_fetch_xor(&this->value, val);
        }
        fun fetch_xor_explicit(*this, val: T, order: MEMORY_ORDERING) -> T
            where T: operator::bin_xor 
        {
            return atomic_fetch_xor_explicit(&this->value, val, order);
        }
    }
}
