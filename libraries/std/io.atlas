import "core/libc";
import "std/string";

private extern fun atlas77_get_stdin_impl() -> *FILE;
private extern fun atlas77_get_stdout_impl() -> *FILE;
private extern fun atlas77_get_stderr_impl() -> *FILE;
private extern fun atlas77_input_impl(buf: *uint8, size: uint64) -> uint64;


namespace std {
    public struct Stdin {
        file_handle: *FILE;
    public:
        fun read(*this, buf: *uint8, size: uint64) -> uint64 {
            return atlas77_input_impl(buf, size);
        }
        ~Stdin() {
            libc::fclose(this->file_handle);
        }
    }

    //! Read a line from standard input
    //! Example: let input = input()
    public fun input() -> std::string {
        let buf = std::string::with_capacity(16);
        let ch = libc::get_char();
        while (ch != '\n' && ch != libc::EOF()) {
            buf.push_char(ch);

            ch = libc::get_char();
        }
        
        return buf;
    }

    //! Panic the program with a value
    //! Example: panic("Something went wrong!")
    #[c_name("panic")]
    public extern fun panic(s: *const uint8);

    //! Well, still needs to be worked on...
    // TODO: Once I implement the formatting system
    // I'll put that into core/libc
    #[c_name("printf")]
    public extern fun printf<T>(fmt: *const uint8, s: T);
    //! Print a value without a newline
    //! Example: print("Hello, ")
    //! print("World!")
    public fun print(s: str) {
        std::printf("%s" as *const uint8, s);
    }

    //! Print a value followed by a newline
    //! Example: println("Hello, World!")
    public fun println(s: str) {
        std::printf("%s\n" as *const uint8, s);
    }
}