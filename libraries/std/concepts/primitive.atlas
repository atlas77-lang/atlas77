namespace std {   
    // TODO: Make this concepts locked. Nobody should be able
    // to extend their own types with std::primitive
    public concept primitive {}
    extend int8 with std::primitive {}
    extend int16 with std::primitive {}
    extend int32 with std::primitive {}
    extend int64 with std::primitive {}
    extend uint8 with std::primitive {}
    extend uint16 with std::primitive {}
    extend uint32 with std::primitive {}
    extend uint64 with std::primitive {}
    extend float32 with std::primitive {}
    extend float64 with std::primitive {}
    extend char with std::primitive {}
    extend bool with std::primitive {}
    extend str with std::primitive {}
}